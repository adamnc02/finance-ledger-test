{
  "name": "finance-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:sync": "vite --mode sync",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:sync": "tsc -b && vite build --mode sync",
    "deploy": "tsc -b && vite build && vite build --mode sync --outDir dist/sync && tsx scripts/check-sync-build.ts && gh-pages -d dist",
    "check:sync-build": "vite build && vite build --mode sync --outDir dist/sync && tsx scripts/check-sync-build.ts",
    "verify": "tsx scripts/verify.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@journeyapps/wa-sqlite": "^2.0.4",
    "@powersync/web": "^2.3.1",
    "@supabase/supabase-js": "^2.116.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.28.0",
    "nanoid": "^6.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "gh-pages": "^6.3.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
